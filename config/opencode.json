{
  "$schema": "https://opencode.ai/config.json",
  "model": "nvidia/nvidia/llama-3.3-nemotron-super-49b-v1.5",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://host.docker.internal:11434/v1",
        "num_ctx": "65536"
      },
      "models": {
        "qwen3-coder-next:latest": {
          "name": "Qwen3 Coder Next"
        }
      }
    },
    "spark": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DGX Spark vLLM (Tailscale)",
      "options": {
        "baseURL": "{env:DGX_VLLM_URL}",
        "apiKey": "no-key-needed"
      },
      "models": {
        "Qwen/Qwen3.6-27B-FP8": {
          "name": "Qwen3.6 27B FP8 (DGX Spark)"
        }
      }
    },
    "nvidia": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NVIDIA NIM (build.nvidia.com)",
      "options": {
        "baseURL": "https://integrate.api.nvidia.com/v1",
        "apiKey": "{env:NVIDIA_API_KEY}"
      },
      "models": {
        "nvidia/llama-3.3-nemotron-super-49b-v1.5": {
          "name": "Nemotron Super 49B v1.5 (labs default, agentic)"
        },
        "mistralai/mistral-nemotron": {
          "name": "Mistral Nemotron (agentic workflows)"
        },
        "nvidia/llama-3.1-nemotron-ultra-253b-v1": {
          "name": "Nemotron Ultra 253B (highest accuracy)"
        },
        "nvidia/nemotron-3-super-120b-a12b": {
          "name": "Nemotron 3 Super 120B (MoE, 12B active)"
        },
        "meta/llama-3.3-70b-instruct": {
          "name": "Llama 3.3 70B Instruct (reliable tools)"
        },
        "deepseek-ai/deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash"
        },
        "nvidia/llama-3.1-nemotron-nano-8b-v1": {
          "name": "Nemotron Nano 8B (fast/cheap)"
        }
      }
    }
  }
}
