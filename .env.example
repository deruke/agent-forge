# agent-forge — API Keys
# Copy to .env and fill in your keys:
#   cp .env.example .env

# AI Agents — at least one required.
# These flow into the container environment (compose `env_file`) and are read by:
#   - Hermes      (process env first; works for ANTHROPIC / OPENAI / NVIDIA / etc.)
#   - OpenCode    (Anthropic + OpenAI auto-detect their env vars; NVIDIA NIM via config/opencode.json)
#   - Claude / Codex CLIs (their respective keys)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# NVIDIA NIM (build.nvidia.com) — free tier, good for labs. Used by Hermes (`hermes-switch nim`)
# and OpenCode's "nvidia" provider.
NVIDIA_API_KEY=
# Google Gemini — used by Hermes' gemini provider (`hermes-switch gemini`). GOOGLE_API_KEY also works.
GEMINI_API_KEY=

# Optional
GITHUB_TOKEN=

# Local model support (Ollama) — only needed if customizing the default model
# Start Ollama on your host machine before launching the container
# OLLAMA_MODEL=qwen3-coder-next:latest

# Hermes Agent + local llama.cpp — NO API key required.
# Hermes is pre-wired to host.docker.internal:8080 via ~/.hermes/config.yaml.
# Start the server on your HOST reachable from the container (NOT 127.0.0.1). Bind to the Docker
# bridge gateway on Linux (172.17.0.1) or 0.0.0.0 on macOS; see README re: LAN exposure:
#   llama-server -m <model.gguf> --host <172.17.0.1|0.0.0.0> --port 8080
# To change model/endpoint: edit ~/.hermes/config.yaml in the running container
# (template: config/hermes-config.yaml) — no rebuild needed.

# Tailscale overlay (docker-compose.tailscale.yml). Reach a tailnet peer (e.g. a DGX vLLM box)
# from the container, anywhere. Keeps Tailscale OFF your host, so a host VPN (Cloudflare WARP) is
# untouched. TS_AUTHKEY is REQUIRED when using the overlay. Mint an ephemeral, tagged key at:
#   https://login.tailscale.com/admin/settings/keys
# TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx
# TS_HOSTNAME=agent-forge                 # node name in your tailnet admin (optional)
# TS_EXTRA_ARGS=--advertise-tags=tag:agent-forge   # optional; only if you've defined the tag in ACLs

# DGX Spark vLLM endpoint over the tailnet. Read by `hermes-switch spark` and OpenCode's "spark"
# provider. Use your DGX's TAILNET IP (tailscale ip -4 on the DGX), not its LAN IP.
# DGX_VLLM_URL=http://100.x.x.x:8000/v1
# DGX_VLLM_MODEL=Qwen/Qwen3.6-27B-FP8

# Package Age Gate — supply chain defense
# Blocks packages published less than THRESHOLD days ago
# Modes: enforce (block), audit (log but allow), off (disabled)
# PACKAGE_AGE_GATE=enforce
# PACKAGE_AGE_GATE_THRESHOLD=7

# Cloud overlay — uncomment if using docker-compose.cloud.yml
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AZURE_SUBSCRIPTION_ID=
# GOOGLE_APPLICATION_CREDENTIALS=/home/operator/.config/gcloud/application_default_credentials.json
